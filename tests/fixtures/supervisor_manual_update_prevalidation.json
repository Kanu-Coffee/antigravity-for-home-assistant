    "telegram_enabled": true,
    "telegram_bot_token": "fixture-telegram-token-never-use",
    "telegram_allowed_chat_ids": [
      "456"
    ],
    "authorized_keys": [
      "ssh-ed25519 fixture"
    ],
    "web_terminal_auto_start_antigravity": true,
    "tmux_session_name": "legacy-session",
    "antigravity_approval_policy": "never",
    "antigravity_sandbox_mode": "danger-full-access",
    "browser_approval_policy": "always",
    "home_assistant_browser_auto_auth": false,
    "home_assistant_browser_token": "fixture-browser-token-never-use",
    "log_level": "debug"
  },
  "expected_dropped_keys": [
