#!/bin/bash -p
set -Eeuo pipefail
unset BASH_ENV ENV NODE_OPTIONS NODE_PATH SUPERVISOR_TOKEN

if (( $# != 0 )); then
  printf 'telegram-action-proposal-mcp: command-line arguments are not supported\n' >&2
  exit 64
fi

telegram_user_id=${HA_TELEGRAM_USER_ID-}
telegram_chat_id=${HA_TELEGRAM_CHAT_ID-}
session_generation=${HA_TELEGRAM_SESSION_GENERATION-}
update_id=${HA_TELEGRAM_UPDATE_ID-}
run_nonce=${HA_TELEGRAM_RUN_NONCE-}
conversation_id=${HA_ANTIGRAVITY_CONVERSATION_ID-}
proposal_socket=${HA_TELEGRAM_ACTION_PROPOSAL_SOCKET-/run/antigravity-ha/telegram-action-proposal.sock}

if [[ "${ANTIGRAVITY_HA_CHANNEL:-}" != telegram ]]; then
  printf 'telegram-action-proposal-mcp: invalid Telegram channel binding\n' >&2
  exit 78
fi
if [[ ! "$telegram_user_id" =~ ^[1-9][0-9]{0,19}$ \
  || ! "$telegram_chat_id" =~ ^-?[1-9][0-9]{0,19}$ \
  || ! "$session_generation" =~ ^[1-9][0-9]{0,15}$ \
  || ! "$update_id" =~ ^[1-9][0-9]{0,15}$ \
  || ! "$run_nonce" =~ ^[A-Za-z0-9_-]{24,128}$ ]]; then
  printf 'telegram-action-proposal-mcp: invalid Telegram run binding\n' >&2
  exit 78
fi
if [[ -n "$conversation_id" \
  && ! "$conversation_id" =~ ^[A-Za-z0-9._:-]{1,256}$ ]]; then
  printf 'telegram-action-proposal-mcp: invalid conversation binding\n' >&2
  exit 78
fi
if [[ ! "$proposal_socket" =~ ^/run/antigravity-ha/[A-Za-z0-9._-]{1,120}\.sock$ ]]; then
  printf 'telegram-action-proposal-mcp: invalid proposal socket\n' >&2
  exit 78
fi

# No model, OAuth, Supervisor, Telegram-bot, browser, or user shell state is
# inherited by the proposal-only process. The bridge rebinds a null first-turn
# conversation to the live conversation for this exact run nonce.
exec /usr/bin/env -i \
  HOME=/tmp \
  LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  ANTIGRAVITY_HA_CHANNEL=telegram \
  HA_TELEGRAM_USER_ID="$telegram_user_id" \
  HA_TELEGRAM_CHAT_ID="$telegram_chat_id" \
  HA_TELEGRAM_SESSION_GENERATION="$session_generation" \
  HA_TELEGRAM_UPDATE_ID="$update_id" \
  HA_TELEGRAM_RUN_NONCE="$run_nonce" \
  HA_ANTIGRAVITY_CONVERSATION_ID="$conversation_id" \
  HA_TELEGRAM_ACTION_PROPOSAL_SOCKET="$proposal_socket" \
  /usr/bin/node \
  /usr/local/share/antigravity-ha/telegram-action-proposal-mcp.mjs
