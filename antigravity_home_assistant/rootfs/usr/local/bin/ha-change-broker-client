#!/usr/bin/env bash
set -Eeuo pipefail

if (( $# != 1 )); then
  printf 'Usage: ha-change-broker-client health|propose|inspect|authorize|execute|execute_status < payload.json\n' >&2
  exit 64
fi

case "$1" in
  health | propose | inspect | authorize | execute | execute_status) ;;
  *)
    printf 'ha-change-broker-client: unsupported action\n' >&2
    exit 64
    ;;
esac

exec /usr/bin/env -i \
  HOME=/data/home \
  LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  /usr/bin/node \
  /usr/local/share/antigravity-ha/ha-change-broker-client.mjs "$1"
