#!/bin/bash -p
set -Eeuo pipefail
unset BASH_ENV ENV NODE_OPTIONS NODE_PATH SUPERVISOR_TOKEN

# shellcheck source=/dev/null
. /usr/local/lib/antigravity-ha/supervisor-credential.sh
antigravity_ha_load_supervisor_credential

# These variables are consumed by the sourced client library.
# shellcheck disable=SC2034
readonly API_PROGRAM_NAME=ha-api
# shellcheck disable=SC2034
readonly API_BASE_URL=http://supervisor/core/api
# shellcheck disable=SC2034
readonly API_CHECK_RESULT=false
# shellcheck disable=SC2034
readonly API_CURL_BIN=/usr/bin/curl
# shellcheck source=/dev/null
. /usr/local/lib/antigravity-ha/api-client.sh
api_main "$@"
