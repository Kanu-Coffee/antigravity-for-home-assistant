#!/bin/bash -p
set -Eeuo pipefail
unset BASH_ENV ENV NODE_OPTIONS NODE_PATH SUPERVISOR_TOKEN

if (( $# != 0 )); then
  printf 'ha-memory-mcp: command-line arguments are not supported\n' >&2
  exit 64
fi

case "${ANTIGRAVITY_HA_MEMORY_READ_ONLY:-0}" in
  0 | 1) readonly memory_read_only="${ANTIGRAVITY_HA_MEMORY_READ_ONLY:-0}" ;;
  *)
    printf 'ha-memory-mcp: invalid read-only mode\n' >&2
    exit 78
    ;;
esac

unset ANTIGRAVITY_HA_CHANNEL
exec /usr/bin/env -i \
  HOME=/tmp \
  LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  ANTIGRAVITY_HA_MEMORY_READ_ONLY="${memory_read_only}" \
  /usr/bin/node /usr/local/share/antigravity-ha/ha-memory-mcp.mjs
