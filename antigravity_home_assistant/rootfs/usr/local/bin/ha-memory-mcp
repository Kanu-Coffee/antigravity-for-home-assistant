#!/bin/bash -p
set -Eeuo pipefail
unset BASH_ENV ENV NODE_OPTIONS NODE_PATH SUPERVISOR_TOKEN

if (( $# != 0 )); then
  printf 'ha-memory-mcp: command-line arguments are not supported\n' >&2
  exit 64
fi

telegram_user_present=0
telegram_chat_present=0
[[ -v HA_TELEGRAM_USER_ID ]] && telegram_user_present=1
[[ -v HA_TELEGRAM_CHAT_ID ]] && telegram_chat_present=1
telegram_read_only=0
if (( telegram_user_present != telegram_chat_present )); then
  printf 'ha-memory-mcp: incomplete Telegram requester binding\n' >&2
  exit 78
elif (( telegram_user_present == 1 )); then
  if [[ ! "${HA_TELEGRAM_USER_ID}" =~ ^[1-9][0-9]{0,19}$ ]] \
    || [[ ! "${HA_TELEGRAM_CHAT_ID}" =~ ^-?[1-9][0-9]{0,19}$ ]]; then
    printf 'ha-memory-mcp: invalid Telegram requester binding\n' >&2
    exit 78
  fi
  telegram_read_only=1
fi

unset HA_TELEGRAM_USER_ID HA_TELEGRAM_CHAT_ID
exec /usr/bin/env -i \
  HOME=/tmp \
  LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  ANTIGRAVITY_HA_TELEGRAM_READ_ONLY="${telegram_read_only}" \
  /usr/bin/node /usr/local/share/antigravity-ha/ha-memory-mcp.mjs
