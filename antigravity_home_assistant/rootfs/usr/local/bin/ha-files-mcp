#!/bin/bash -p
set -Eeuo pipefail
unset BASH_ENV ENV NODE_OPTIONS NODE_PATH SUPERVISOR_TOKEN
unset PYTHONHOME PYTHONPATH

if (( $# != 0 )); then
  printf 'ha-files-mcp: command-line arguments are not supported\n' >&2
  exit 64
fi

exec /usr/bin/env -i \
  HOME=/tmp \
  LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  /usr/bin/python3 -I -B -u \
  /usr/local/share/antigravity-ha/ha-files-mcp.py
