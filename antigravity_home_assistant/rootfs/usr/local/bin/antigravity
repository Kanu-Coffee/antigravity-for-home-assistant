#!/usr/bin/env bash
set -Eeuo pipefail

# Keep one stable launcher for Ingress, SSH, scripts, and the `agy` alias. The
# real Antigravity CLI reads its native JSON settings and plugin registry from
# HOME; do not translate App options into Codex-style `-c` overrides here.
# shellcheck source=/dev/null
. /usr/local/lib/antigravity-ha/environment.sh
# shellcheck source=/dev/null
. /usr/local/lib/antigravity-ha/config.sh

for argument in "$@"; do
  case "${argument}" in
    -dangerously-skip-permissions | -dangerously-skip-permissions=* \
      | --dangerously-skip-permissions | --dangerously-skip-permissions=*)
      echo 'antigravity: --dangerously-skip-permissions is disabled in this App' >&2
      exit 78
      ;;
  esac
done
unset argument

terminal_sandbox=true
if [[ -e "${ANTIGRAVITY_HA_OPTIONS_FILE}" ]]; then
  if ! terminal_sandbox=$(antigravity_ha_config_bool \
    antigravity_terminal_sandbox true); then
    echo 'antigravity: antigravity_terminal_sandbox must be a boolean' >&2
    exit 78
  fi
fi

antigravity_HA_NATIVE_ARGS=()
if [[ "${terminal_sandbox}" == true ]]; then
  sandbox_present=false
  for argument in "$@"; do
    case "${argument}" in
      -sandbox | --sandbox | -sandbox=true | --sandbox=true)
        sandbox_present=true
        ;;
      -sandbox=* | --sandbox=*)
        echo 'antigravity: sandbox overrides must use the exact value true' >&2
        exit 78
        ;;
    esac
  done
  if [[ "${sandbox_present}" == false ]]; then
    antigravity_HA_NATIVE_ARGS+=(--sandbox)
  fi
  unset sandbox_present
fi
unset terminal_sandbox argument

sensitive_data_access=false
if [[ -e "${ANTIGRAVITY_HA_OPTIONS_FILE}" ]]; then
  if ! sensitive_data_access=$(antigravity_ha_config_bool \
    antigravity_sensitive_data_access false); then
    echo 'antigravity: antigravity_sensitive_data_access must be a boolean' >&2
    exit 78
  fi
fi
if [[ "${sensitive_data_access}" == true ]]; then
  antigravity_HA_LAUNCHER=/usr/local/libexec/antigravity-interactive-sensitive-read
else
  antigravity_HA_LAUNCHER=/usr/local/libexec/antigravity-interactive-restricted
fi
unset sensitive_data_access

exec "${antigravity_HA_LAUNCHER}" \
  "${antigravity_HA_NATIVE_ARGS[@]}" "$@"
