#!/usr/bin/env bash
set -Eeuo pipefail

# Keep config.json user-owned while applying current App options
# shellcheck source=/dev/null
. /usr/local/lib/antigravity-ha/environment.sh
# shellcheck source=/dev/null
. /usr/local/lib/antigravity-ha/config.sh
# shellcheck source=/dev/null
. /usr/local/lib/antigravity-ha/browser-approval.sh

# Inject ANTIGRAVITY_TOKEN from add-on options if provided
if antigravity_ha_config_validate; then
  _antigravity_token=$(antigravity_ha_config_string 'antigravity_token' '')
  if [[ -n "${_antigravity_token}" ]]; then
    export ANTIGRAVITY_TOKEN="${_antigravity_token}"
  fi
  unset _antigravity_token
fi

approval_policy=on-request
sandbox_mode=danger-full-access
browser_approval_policy=safe
if antigravity_ha_config_validate; then
  approval_policy=$(antigravity_ha_config_string 'antigravity_approval_policy' 'on-request')
  sandbox_mode=$(antigravity_ha_config_string 'antigravity_sandbox_mode' 'danger-full-access')
  if ! browser_approval_policy=$(antigravity_ha_config_string 'browser_approval_policy' 'safe'); then
    printf 'antigravity: invalid headless browser approval policy\n' >&2
    exit 78
  fi
fi

case "${approval_policy}" in
  untrusted | on-request | never) ;;
  *)
    printf 'antigravity: invalid App approval policy\n' >&2
    exit 78
    ;;
esac
case "${sandbox_mode}" in
  workspace-write | danger-full-access) ;;
  *)
    printf 'antigravity: invalid App sandbox mode\n' >&2
    exit 78
    ;;
esac
if ! antigravity_ha_browser_approval_policy_validate "${browser_approval_policy}"; then
  printf 'antigravity: invalid headless browser approval policy\n' >&2
  exit 78
fi
if ! antigravity_ha_browser_build_approval_args "${browser_approval_policy}"; then
  printf 'antigravity: unable to apply headless browser approval policy\n' >&2
  exit 78
fi

exec /usr/local/libexec/antigravity-real \
  "${antigravity_HA_BROWSER_APPROVAL_ARGS[@]}" \
  "$@"
