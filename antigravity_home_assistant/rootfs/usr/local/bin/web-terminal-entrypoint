#!/bin/bash -p
set -Eeuo pipefail
unset BASH_ENV ENV NODE_OPTIONS NODE_PATH SUPERVISOR_TOKEN
unset ANTIGRAVITY_TOKEN

# shellcheck source=/dev/null
. /usr/local/lib/antigravity-ha/environment.sh
# ttyd sets TERM for each PTY, but S6 with-contenv rebuilds the child
# environment and drops that connection-specific value. Restore the terminal
# contract before tmux validates the outer terminal capabilities.
export TERM=xterm-256color

background=false
case "$#" in
  0) ;;
  1)
    if [[ "$1" != --background ]]; then
      printf 'Usage: web-terminal-entrypoint [--background]\n' >&2
      exit 64
    fi
    background=true
    ;;
  *)
    printf 'Usage: web-terminal-entrypoint [--background]\n' >&2
    exit 64
    ;;
esac

readonly session_name=antigravity-ha

cd /config
if [[ "${background}" == true ]]; then
  if tmux has-session -t "${session_name}" 2>/dev/null; then
    exit 0
  fi
  exec tmux -u new-session -d -s "${session_name}" -c /config \
    /usr/local/bin/tmux-session-shell
fi
exec tmux -u new-session -A -s "${session_name}" -c /config /usr/local/bin/tmux-session-shell
