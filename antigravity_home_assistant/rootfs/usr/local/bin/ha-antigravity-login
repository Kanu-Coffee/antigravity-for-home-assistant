#!/bin/bash -p
set -Eeuo pipefail
unset BASH_ENV ENV NODE_OPTIONS NODE_PATH SUPERVISOR_TOKEN
unset GLIBC_TUNABLES LD_AUDIT LD_DEBUG LD_LIBRARY_PATH LD_PRELOAD
unset PYTHONHOME PYTHONINSPECT PYTHONPATH PYTHONSTARTUP
unset GCONV_PATH GETCONF_DIR HOSTALIASES LOCALDOMAIN LOCPATH MALLOC_TRACE
unset NLSPATH RES_OPTIONS TMPDIR TZDIR
umask 077

if (( $# != 0 )); then
  printf 'Usage: ha-antigravity-login\n' >&2
  exit 64
fi

original_tty=$(/usr/bin/tty 2>/dev/null || true)
tmux_target=''
tmux_socket_identity=''
tmux_cleanup_expected=false
readonly TMUX_SOCKET=/data/tmux/tmux-0/default
if [[ ${original_tty} =~ ^/dev/pts/[0-9]+$ \
  && -S ${TMUX_SOCKET} ]]; then
  tmux_socket_identity=$(
    /usr/bin/stat -Lc '%u:%g:%a:%h:%d:%i' "${TMUX_SOCKET}" 2>/dev/null || true
  )
  if [[ ${tmux_socket_identity} \
    =~ ^0:0:[0-7]+:1:[0-9]+:[0-9]+$ ]]; then
    derived_target=''
    derived_matches=0
    while IFS=' ' read -r pane_id pane_tty extra; do
      if [[ -z ${extra:-} && ${pane_id} =~ ^%[0-9]+$ \
        && ${pane_tty} == "${original_tty}" ]]; then
        derived_target=${pane_id}
        (( derived_matches += 1 ))
      fi
    done < <(
      /usr/bin/tmux -S "${TMUX_SOCKET}" list-panes -a \
        -F '#{pane_id} #{pane_tty}' 2>/dev/null || true
    )
    if (( derived_matches == 1 )); then
      tmux_cleanup_expected=true
      if [[ -z ${TMUX_PANE:-} || ${TMUX_PANE} == "${derived_target}" ]]; then
        tmux_target=${derived_target}
      fi
    elif [[ -n ${TMUX_PANE:-} ]]; then
      tmux_cleanup_expected=true
    fi
    unset derived_target derived_matches pane_id pane_tty extra
  fi
elif [[ -n ${TMUX_PANE:-} ]]; then
  tmux_cleanup_expected=true
fi
unset TMUX TMUX_PANE

if [[ -n ${tmux_target} ]]; then
  printf '%s\n' \
    'For OAuth privacy, this Web pane history will be cleared when onboarding closes.'
fi

# Native first-run state is the only writable surface in the onboarding
# boundary. Never start it from the Home Assistant configuration workspace or
# pass the authenticated shell's environment across the profile transition.
cd /
trap '' INT QUIT
trap ':' HUP TERM
set +e
/usr/bin/env --default-signal=INT --default-signal=QUIT -i \
  HOME=/data/home \
  LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  PATH=/usr/bin:/bin \
  TERM=xterm-256color \
  /usr/local/libexec/antigravity-onboarding-controller
controller_status=$?
set -e

# OAuth URLs and pasted authorization codes must not remain in the shared Web
# pane's reconnectable history. Clear only a pane whose fixed socket lookup,
# pane id, and PTY all match this authenticated caller. SSH receives the ANSI
# saved-scrollback erase as a best-effort terminal operation.
tmux_cleanup_candidate=false
tmux_cleanup_succeeded=false
if [[ -n ${tmux_target} \
  && $(/usr/bin/stat -Lc '%u:%g:%a:%h:%d:%i' "${TMUX_SOCKET}" \
      2>/dev/null || true) == "${tmux_socket_identity}" ]]; then
  pane_metadata=$(
    /usr/bin/tmux -S "${TMUX_SOCKET}" display-message -p \
      -t "${tmux_target}" '#{pane_id} #{pane_tty}' 2>/dev/null || true
  )
  if [[ ${pane_metadata} == "${tmux_target} ${original_tty}" ]]; then
    tmux_cleanup_candidate=true
  fi
  unset pane_metadata
fi
printf '\033[3J\033[2J\033[H'
# The ANSI erase itself is pane output. Revalidate after emitting it, then make
# clear-history the final destructive pane operation so the erase cannot move
# the former visible screen back into reconnectable tmux history.
if [[ ${tmux_cleanup_candidate} == true \
  && $(/usr/bin/stat -Lc '%u:%g:%a:%h:%d:%i' "${TMUX_SOCKET}" \
      2>/dev/null || true) == "${tmux_socket_identity}" ]]; then
  pane_metadata=$(
    /usr/bin/tmux -S "${TMUX_SOCKET}" display-message -p \
      -t "${tmux_target}" '#{pane_id} #{pane_tty}' 2>/dev/null || true
  )
  if [[ ${pane_metadata} == "${tmux_target} ${original_tty}" ]]; then
    if /usr/bin/tmux -S "${TMUX_SOCKET}" clear-history -t "${tmux_target}" \
      >/dev/null 2>&1; then
      tmux_cleanup_succeeded=true
    fi
  fi
  unset pane_metadata
fi
privacy_cleanup_ready=false
if [[ ${tmux_cleanup_expected} == false \
  || ${tmux_cleanup_succeeded} == true ]]; then
  privacy_cleanup_ready=true
fi
if [[ ${tmux_cleanup_expected} == true \
  && ${tmux_cleanup_succeeded} != true ]]; then
  printf '%s\n' \
    'Warning: the shared Web pane history could not be verified as cleared; close or restart this terminal session before continuing.' >&2
  if (( controller_status != 79 )); then controller_status=80; fi
fi
if [[ ${privacy_cleanup_ready} == true && ${controller_status} != 79 ]]; then
  set +e
  /usr/bin/env --default-signal=INT --default-signal=QUIT -i \
    HOME=/data/home \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PATH=/usr/bin:/bin \
    TERM=xterm-256color \
    /usr/local/libexec/antigravity-onboarding-controller --privacy-finalize \
    >/dev/null 2>&1
  privacy_finalize_status=$?
  set -e
  if (( privacy_finalize_status != 0 \
    && privacy_finalize_status != 77 \
    && privacy_finalize_status != 79 )); then
    controller_status=81
  fi
  unset privacy_finalize_status
fi
case "${controller_status}" in
  0)
    printf '%s\n' \
      'Validated local consumer onboarding files were saved; remote Terms acceptance was not inferred.' \
      'Start a normal protected session with: agy' \
      'If Terms are shown again, rerun ha-antigravity-login.'
    ;;
  79)
    printf '%s\n' \
      'Protected consumer onboarding recovery was saved.' \
      'Restart the App before starting a normal Antigravity session.'
    ;;
  80)
    printf '%s\n' \
      'Protected onboarding state is unknown because Web pane privacy cleanup was not verified.' \
      'Restart the App before any normal Antigravity session; close the OAuth tab and clear the clipboard.' >&2
    ;;
  81)
    printf '%s\n' \
      'Protected onboarding did not reach a safely finalized privacy state.' \
      'Restart the App before any normal Antigravity session; close the OAuth tab and clear the clipboard.' >&2
    ;;
  76)
    printf '%s\n' \
      'Consumer onboarding is incomplete; rerun ha-antigravity-login.' >&2
    ;;
  124 | 137)
    printf '%s\n' \
      'Consumer onboarding timed out; rerun ha-antigravity-login.' >&2
    ;;
  *)
    printf 'Protected consumer onboarding closed with status %s.\n' \
      "${controller_status}" >&2
    ;;
esac
exit "${controller_status}"
