#!/bin/bash -p
set -Eeuo pipefail
unset BASH_ENV ENV NODE_OPTIONS NODE_PATH SUPERVISOR_TOKEN

quiet=0
if (( $# == 1 )) && [[ $1 == --quiet ]]; then
  quiet=1
elif (( $# != 0 )); then
  echo 'Usage: ha-browser-auth-ensure [--quiet]' >&2
  exit 2
fi

# shellcheck source=/dev/null
. /usr/local/lib/antigravity-ha/config.sh

refresh_auth() {
  if (( quiet )); then
    /usr/local/bin/ha-browser-auth-refresh --quiet
  else
    /usr/local/bin/ha-browser-auth-refresh
  fi
}

if ! antigravity_ha_config_validate; then
  refresh_auth
  exit $?
fi

if ! auto_auth=$(antigravity_ha_config_bool home_assistant_browser_auto_auth true); then
  refresh_auth
  exit $?
fi
if [[ "${auto_auth}" != true ]]; then
  unset auto_auth
  refresh_auth
  exit $?
fi
unset auto_auth

if refresh_auth; then
  exit 0
fi

if (( quiet )); then
  /usr/local/bin/ha-browser-auth-setup >/dev/null 2>&1
else
  /usr/local/bin/ha-browser-auth-setup
fi
