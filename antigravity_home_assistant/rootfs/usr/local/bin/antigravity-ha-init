#!/command/with-contenv bashio
# shellcheck shell=bash
set -Eeuo pipefail

# Capture the injected Supervisor credential before any external command, then
# remove it from the environment inherited by ordinary services and agents.
supervisor_credential_bootstrap=${SUPERVISOR_TOKEN:-}
unset SUPERVISOR_TOKEN
export -n supervisor_credential_bootstrap
umask 077

readonly RUNTIME_DIR=/run/antigravity-ha
readonly DATA_HOME=/data/home
readonly APP_STATE_ROOT=/data/antigravity-ha
readonly ANTIGRAVITY_DATA=/data/antigravity
readonly GITHUB_CLI_DATA=/data/github-cli
readonly TMUX_DATA=/data/tmux
readonly PLAYWRIGHT_HOME=${RUNTIME_DIR}/playwright-home
readonly PLAYWRIGHT_OUTPUT=${RUNTIME_DIR}/playwright-output
readonly OPTIONS_SNAPSHOT=${RUNTIME_DIR}/ha-feedback-options.json
readonly SENSITIVE_DATA_ACCESS_MARKER=${RUNTIME_DIR}/sensitive-data-access.enabled
readonly HA_RENDER_UPSTREAM=${RUNTIME_DIR}/home-assistant-render-upstream.conf
readonly HA_BROWSER_AUTH_STATUS=${RUNTIME_DIR}/browser-auth-status.json
readonly HA_BROWSER_NETWORK_STATUS=${RUNTIME_DIR}/browser-network-info.json
readonly FACTORY_RESET=/usr/local/share/antigravity-ha/v3-factory-reset.mjs
readonly OPTIONS_RESET=/usr/local/share/antigravity-ha/supervisor-options-migrate.mjs
readonly OPTIONS_RESET_MARKER=/data/.antigravity-ha-v3-options-complete.json
readonly MANAGED_PLUGIN_UPDATE=/usr/local/share/antigravity-ha/managed-plugin-update.mjs

factory_reset_result=$(/usr/bin/node "${FACTORY_RESET}") || {
  bashio::log.fatal 'The required 3.0 App-data factory reset could not be completed safely'
  exit 1
}
if ! jq --exit-status '
  type == "object"
  and (.status == "reset" or .status == "already_complete")
  and (.removed | type == "array")
' <<< "${factory_reset_result}" >/dev/null; then
  bashio::log.fatal 'The 3.0 factory reset helper returned an invalid result'
  exit 1
fi
if jq --exit-status '.status == "reset"' <<< "${factory_reset_result}" >/dev/null; then
  bashio::log.warning 'Completed the one-time 3.0 factory reset of App-owned data; Home Assistant configuration was not touched'
fi
unset factory_reset_result

rm -rf -- "${PLAYWRIGHT_HOME}" "${PLAYWRIGHT_OUTPUT}"
install -d -m 0700 \
  "${RUNTIME_DIR}" \
  "${DATA_HOME}" \
  "${APP_STATE_ROOT}" \
  "${ANTIGRAVITY_DATA}" \
  "${GITHUB_CLI_DATA}" \
  "${TMUX_DATA}" \
  "${PLAYWRIGHT_HOME}" \
  "${PLAYWRIGHT_OUTPUT}"

for persistent_directory in \
  "${DATA_HOME}" \
  "${APP_STATE_ROOT}" \
  "${ANTIGRAVITY_DATA}" \
  "${GITHUB_CLI_DATA}" \
  "${TMUX_DATA}"; do
  if [[ -L ${persistent_directory} || ! -d ${persistent_directory} \
    || $(stat -Lc '%u:%g' "${persistent_directory}") != 0:0 ]]; then
    bashio::log.fatal "Unsafe persistent App directory: ${persistent_directory}"
    exit 1
  fi
  chmod 0700 "${persistent_directory}"
done
unset persistent_directory

if ! jq --exit-status 'type == "object"' /data/options.json >/dev/null; then
  bashio::log.fatal '/data/options.json is missing or invalid'
  exit 1
fi

# Until the one-time Supervisor options reset has been confirmed, ignore all
# stored legacy options and use the 3.0 defaults. The snapshot is the only App
# option surface visible outside the init confinement.
options_reset_complete=false
if [[ -e ${OPTIONS_RESET_MARKER} || -L ${OPTIONS_RESET_MARKER} ]]; then
  if [[ -L ${OPTIONS_RESET_MARKER} || ! -f ${OPTIONS_RESET_MARKER} ]]; then
    bashio::log.fatal 'The 3.0 option-reset marker is unsafe'
    exit 1
  fi
  options_marker_metadata=$(stat -c '%f:%d:%i:%u:%g:%a:%h:%s:%Y:%Z' \
    -- "${OPTIONS_RESET_MARKER}" 2>/dev/null) || {
    bashio::log.fatal 'The 3.0 option-reset marker is unavailable'
    exit 1
  }
  IFS=: read -r marker_raw_mode marker_device marker_inode marker_owner \
    marker_group marker_mode marker_links marker_size _ \
    <<< "${options_marker_metadata}"
  if [[ ! ${marker_raw_mode} =~ ^8[0-9a-fA-F]{3}$ \
    || ! ${marker_device} =~ ^[0-9]+$ || ! ${marker_inode} =~ ^[0-9]+$ \
    || ${marker_owner} != 0 || ${marker_group} != 0 \
    || ${marker_mode} != 600 || ${marker_links} != 1 \
    || ! ${marker_size} =~ ^[0-9]+$ ]] \
    || (( marker_size < 2 || marker_size > 4096 )) \
    || ! jq --exit-status '
      type == "object"
      and keys == ["completed", "schema"]
      and .completed == true
      and .schema == "antigravity-ha-v3-options-reset/v1"
    ' "${OPTIONS_RESET_MARKER}" >/dev/null \
    || [[ $(stat -c '%f:%d:%i:%u:%g:%a:%h:%s:%Y:%Z' \
      -- "${OPTIONS_RESET_MARKER}" 2>/dev/null) != "${options_marker_metadata}" ]]; then
    bashio::log.fatal 'The 3.0 option-reset marker is invalid or unstable'
    exit 1
  fi
  options_reset_complete=true
  unset options_marker_metadata marker_raw_mode marker_device marker_inode \
    marker_owner marker_group marker_mode marker_links marker_size
fi

options_tmp=$(mktemp "${RUNTIME_DIR}/.options.XXXXXX")
if [[ ${options_reset_complete} == false ]]; then
  jq --null-input '{
    remote_control_name: "home-assistant",
    antigravity_sensitive_data_access: false,
    home_assistant_browser_auto_auth: true,
    log_level: "info"
  }' > "${options_tmp}"
elif ! jq --exit-status '
  def option_string($key; $default):
    (if has($key) then .[$key] else $default end)
    | if type == "string" then . else error("invalid string option") end;
  def option_bool($key; $default):
    (if has($key) then .[$key] else $default end)
    | if type == "boolean" then . else error("invalid boolean option") end;
  {
    remote_control_name: option_string("remote_control_name"; "home-assistant"),
    antigravity_sensitive_data_access: option_bool("antigravity_sensitive_data_access"; false),
    home_assistant_browser_auto_auth: option_bool("home_assistant_browser_auto_auth"; true),
    log_level: option_string("log_level"; "info")
  }
  | .log_level as $log_level
  | if (.remote_control_name | test("^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"))
      and (["trace", "debug", "info", "notice", "warning", "error", "fatal"] | index($log_level) != null)
    then . else error("invalid 3.0 option") end
' /data/options.json > "${options_tmp}"; then
  rm -f "${options_tmp}"
  bashio::log.fatal 'The active 3.0 App options are invalid'
  exit 1
fi
chmod 0600 "${options_tmp}"
mv -f "${options_tmp}" "${OPTIONS_SNAPSHOT}"
unset options_reset_complete

# shellcheck source=/dev/null
. /usr/local/lib/antigravity-ha/config.sh
antigravity_ha_config_validate || {
  bashio::log.fatal 'The allowlisted App option snapshot is invalid'
  exit 1
}

rm -f "${SENSITIVE_DATA_ACCESS_MARKER}"
if antigravity_ha_config_true antigravity_sensitive_data_access; then
  sensitive_tmp=$(mktemp "${RUNTIME_DIR}/.sensitive-data-access.XXXXXX")
  printf 'enabled\n' > "${sensitive_tmp}"
  chmod 0400 "${sensitive_tmp}"
  mv -f "${sensitive_tmp}" "${SENSITIVE_DATA_ACCESS_MARKER}"
  unset sensitive_tmp
fi

if [[ ! -d /config || ! -w /config ]]; then
  bashio::log.fatal '/config must be mounted read-write'
  exit 1
fi
write_probe=$(mktemp /config/.antigravity-ha-write-test.XXXXXX)
rm -f "${write_probe}"
bashio::log.info 'Verified read-write access to /config'

# Create only the two native bootstrap files on a fresh HOME. Future App starts
# preserve user settings; the image-managed plugin has its own transaction.
install -d -m 0700 \
  "${DATA_HOME}/.gemini" \
  "${DATA_HOME}/.gemini/antigravity-cli" \
  "${DATA_HOME}/.gemini/config"
for source_and_target in \
  '/etc/antigravity/settings.json:/data/home/.gemini/antigravity-cli/settings.json' \
  '/etc/antigravity/mcp_config.json:/data/home/.gemini/config/mcp_config.json'; do
  source_path=${source_and_target%%:*}
  target_path=${source_and_target#*:}
  if [[ ! -e ${target_path} && ! -L ${target_path} ]]; then
    install -m 0600 "${source_path}" "${target_path}"
  elif [[ ! -f ${target_path} || -L ${target_path} \
    || $(stat -Lc '%u:%g:%h' "${target_path}") != 0:0:1 ]]; then
    bashio::log.fatal "Unsafe Antigravity user file: ${target_path}"
    exit 1
  else
    chmod 0600 "${target_path}"
  fi
done
unset source_and_target source_path target_path

managed_plugin_result=$(
  /usr/bin/env -i \
    AGY_CLI_DISABLE_AUTO_UPDATE=true \
    HOME="${DATA_HOME}" \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    /usr/bin/node "${MANAGED_PLUGIN_UPDATE}"
) || {
  bashio::log.fatal 'The image-managed Home Assistant plugin could not be installed safely'
  exit 1
}
if ! jq --exit-status '
  type == "object"
  and (.degraded | type == "boolean")
  and (.recovered | type == "boolean")
  and (.updated | type == "boolean")
' <<< "${managed_plugin_result}" >/dev/null; then
  bashio::log.fatal 'The managed plugin helper returned an invalid result'
  exit 1
fi
if jq --exit-status '.degraded' <<< "${managed_plugin_result}" >/dev/null; then
  bashio::log.warning "$(jq --raw-output '.warning' <<< "${managed_plugin_result}")"
elif jq --exit-status '.updated' <<< "${managed_plugin_result}" >/dev/null; then
  bashio::log.notice 'Installed the image-managed Home Assistant plugin'
fi
unset managed_plugin_result

supervisor_credential_available=false
if [[ -n ${supervisor_credential_bootstrap} ]]; then
  if [[ ${supervisor_credential_bootstrap} == *$'\n'* \
    || ${supervisor_credential_bootstrap} == *$'\r'* \
    || ${#supervisor_credential_bootstrap} -gt 4096 ]]; then
    unset supervisor_credential_bootstrap
    bashio::log.fatal 'Supervisor token is unavailable or unsafe'
    exit 1
  fi
  credential_tmp=$(mktemp "${RUNTIME_DIR}/.supervisor.token.XXXXXX")
  printf '%s' "${supervisor_credential_bootstrap}" > "${credential_tmp}"
  chmod 0400 "${credential_tmp}"
  mv -f "${credential_tmp}" "${RUNTIME_DIR}/supervisor.token"
  supervisor_credential_available=true
  unset credential_tmp
else
  rm -f "${RUNTIME_DIR}/supervisor.token"
fi
unset supervisor_credential_bootstrap

if [[ ${supervisor_credential_available} == true ]]; then
  if options_reset_result=$(/usr/bin/node "${OPTIONS_RESET}") \
    && jq --exit-status '
      type == "object"
      and (.status == "reset" or .status == "already_complete")
    ' <<< "${options_reset_result}" >/dev/null; then
    if jq --exit-status '.status == "reset"' <<< "${options_reset_result}" >/dev/null; then
      bashio::log.notice 'Reset Supervisor App options to the 3.0 interface'
    fi
  else
    bashio::log.warning 'The Supervisor option reset is pending and will retry on the next App start'
  fi
  unset options_reset_result
  bashio::log.info 'Configured the isolated Core and Supervisor helper credential'
else
  bashio::log.warning 'SUPERVISOR_TOKEN is unavailable; API helpers and option reset remain disabled'
fi

if /usr/local/bin/ha-memory init >/dev/null 2>&1; then
  bashio::log.info 'Initialized the Home Assistant memory store'
else
  bashio::log.error 'Home Assistant memory is unavailable; other services will continue'
fi

unset NODE_OPTIONS NODE_PATH
for variable in "${!PLAYWRIGHT_MCP_@}"; do unset "${variable}"; done
/usr/local/bin/ha-browser-auth-ensure --quiet || true
browser_auth_status=$(jq --raw-output '.status // "unavailable"' \
  "${HA_BROWSER_AUTH_STATUS}" 2>/dev/null || printf 'unavailable')
case "${browser_auth_status}" in
  ready) bashio::log.info 'Validated the local-only read-only browser identity' ;;
  disabled) bashio::log.info 'Browser automatic authentication is disabled' ;;
  *) bashio::log.warning 'Browser automatic authentication is not ready; inspect ha-browser-auth-status' ;;
esac
unset browser_auth_status

ha_frontend_scheme=http
ha_frontend_port=8123
if [[ ${supervisor_credential_available} == true ]]; then
  core_info_tmp=$(mktemp "${RUNTIME_DIR}/.core-info.XXXXXX")
  if /usr/local/bin/supervisor-api --raw GET /core/info > "${core_info_tmp}" 2>/dev/null; then
    candidate_port=$(jq --raw-output 'select(.result == "ok") | .data.port // 8123' "${core_info_tmp}" 2>/dev/null || true)
    candidate_scheme=$(jq --raw-output 'select(.result == "ok") | if (.data.ssl // false) then "https" else "http" end' "${core_info_tmp}" 2>/dev/null || true)
    if [[ ${candidate_port} =~ ^[0-9]+$ ]] \
      && (( candidate_port >= 1 && candidate_port <= 65535 )) \
      && [[ ${candidate_scheme} == http || ${candidate_scheme} == https ]]; then
      ha_frontend_port=${candidate_port}
      ha_frontend_scheme=${candidate_scheme}
    fi
  fi
  rm -f "${core_info_tmp}"
fi
unset supervisor_credential_available candidate_port candidate_scheme

upstream_tmp=$(mktemp "${RUNTIME_DIR}/.home-assistant-render-upstream.XXXXXX")
# shellcheck disable=SC2016  # nginx variable must remain literal.
printf 'set %s "%s://homeassistant:%s";\n' \
  '$ha_frontend_upstream' "${ha_frontend_scheme}" "${ha_frontend_port}" > "${upstream_tmp}"
chmod 0600 "${upstream_tmp}"
mv -f "${upstream_tmp}" "${HA_RENDER_UPSTREAM}"

network_tmp=$(mktemp "${RUNTIME_DIR}/.browser-network-info.XXXXXX")
if /usr/local/bin/ha-browser-network-info > "${network_tmp}" 2>/dev/null; then
  chmod 0600 "${network_tmp}"
  mv -f "${network_tmp}" "${HA_BROWSER_NETWORK_STATUS}"
else
  rm -f "${network_tmp}" "${HA_BROWSER_NETWORK_STATUS}"
fi

nginx -t -c /etc/nginx/nginx.conf
native_version=$(/usr/local/libexec/antigravity-real --version)
bashio::log.info "Antigravity ${native_version} runtime ready"
unset native_version

bashio::log.info 'Initializing the Ingress recovery terminal'
/usr/local/bin/web-terminal-entrypoint --background || true
