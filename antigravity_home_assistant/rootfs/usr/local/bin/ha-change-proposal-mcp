#!/bin/bash -p
set -Eeuo pipefail
unset BASH_ENV ENV NODE_OPTIONS NODE_PATH SUPERVISOR_TOKEN

if (( $# != 0 )); then
  printf 'ha-change-proposal-mcp: command-line arguments are not supported\n' >&2
  exit 64
fi

telegram_user_id=${HA_TELEGRAM_USER_ID-}
telegram_chat_id=${HA_TELEGRAM_CHAT_ID-}
if [[ "${ANTIGRAVITY_HA_CHANNEL:-}" != telegram ]]; then
  printf 'ha-change-proposal-mcp: invalid Telegram channel binding\n' >&2
  exit 78
fi
if [[ ! "$telegram_user_id" =~ ^[1-9][0-9]{0,19}$ ]]; then
  printf 'ha-change-proposal-mcp: invalid Telegram user binding\n' >&2
  exit 78
fi
if [[ ! "$telegram_chat_id" =~ ^-?[1-9][0-9]{0,19}$ ]]; then
  printf 'ha-change-proposal-mcp: invalid Telegram chat binding\n' >&2
  exit 78
fi

# Start with a closed environment so the proposal-only MCP cannot inherit the
# Supervisor, Telegram, browser, or Antigravity OAuth credentials.
exec /usr/bin/env -i \
  HOME=/data/home \
  LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  HA_TELEGRAM_USER_ID="$telegram_user_id" \
  HA_TELEGRAM_CHAT_ID="$telegram_chat_id" \
  /usr/bin/node \
  /usr/local/share/antigravity-ha/ha-change-proposal-mcp.mjs
