#!/bin/bash -p
set -Eeuo pipefail
unset BASH_ENV ENV NODE_OPTIONS NODE_PATH SUPERVISOR_TOKEN

if (( $# != 0 )); then
  printf 'ha-telegram-runtime: command-line arguments are not supported\n' >&2
  exit 64
fi

if ! /usr/bin/jq --exit-status '.telegram_enabled == true' \
  /data/options.json >/dev/null 2>&1; then
  exec /command/s6-pause
fi

exec /usr/bin/env -i \
  AGY_CLI_DISABLE_AUTO_UPDATE=true \
  HOME=/tmp \
  LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  /usr/bin/node /usr/local/share/antigravity-ha/telegram-bridge.mjs
