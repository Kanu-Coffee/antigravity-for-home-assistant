#!/bin/bash -p
set -Eeuo pipefail
unset BASH_ENV ENV NODE_OPTIONS NODE_PATH SUPERVISOR_TOKEN

# OpenSSH invokes the account shell with no arguments for an interactive login
# and with "-c <command>" for a remote command. Re-establish only the
# image-managed non-interactive Bash environment; never trust a caller-supplied
# BASH_ENV across the sshd profile boundary.
export BASH_ENV=/etc/profile.d/antigravity-ha.sh

if (( $# == 0 )); then
  exec /bin/bash -l
fi

exec /bin/bash "$@"
