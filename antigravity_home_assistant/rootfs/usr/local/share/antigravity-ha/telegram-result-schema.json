{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "response": {
      "type": "string",
      "maxLength": 32768
    },
    "proposal_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{20,64}$"
      },
      "maxItems": 1,
      "uniqueItems": true
    }
  },
  "required": ["response", "proposal_ids"],
  "additionalProperties": false
}
