#!/command/with-contenv bashio
# shellcheck shell=bash
set -Eeuo pipefail

exit_code=${1:-1}
if [[ ${exit_code} -ne 0 && ${exit_code} -ne 256 ]]; then
  bashio::log.warning "Antigravity Remote Control stopped with exit code ${exit_code}; retrying in 5s"
else
  bashio::log.warning 'Antigravity Remote Control stopped; S6 will restart it'
fi

/bin/sleep 5
