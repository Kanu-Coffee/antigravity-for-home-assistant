#!/usr/bin/env bash
set -Eeuo pipefail

readonly IMAGE="ghcr.io/kanu-coffee/antigravity-for-home-assistant@sha256:1f4b996b8eb1e7f4028a5f5ac8383a79da550af4cd826f8ad9611ea607b33e91"
readonly MEMORY_VOLUME="antigravity-ha-development-memory"

usage() {
  echo "usage: tools/development/setup [check|install]" >&2
}

if (($# > 1)); then
  usage
  exit 64
fi
command_name="${1:-check}"
if [[ $command_name != check && $command_name != install ]]; then
  usage
  exit 64
fi

script_directory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repository_root="$(git -C "$script_directory" rev-parse --show-toplevel 2>/dev/null)" || {
  echo "setup must run inside the Antigravity source checkout" >&2
  exit 69
}
[[ $script_directory == "$repository_root/tools/development" ]] || {
  echo "development setup path does not match the repository root" >&2
  exit 69
}

probe="$script_directory/memory-mcp-probe.mjs"
[[ -f $probe && -f $repository_root/AGENTS.md && -f $repository_root/.codex/config.toml ]] || {
  echo "development setup assets are incomplete" >&2
  exit 69
}

docker_bin="docker"
test_mode=0
if [[ ${ANTIGRAVITY_HA_DEV_TEST_MODE:-0} == 1 ]]; then
  test_mode=1
  docker_bin="${ANTIGRAVITY_HA_DEV_DOCKER_BIN:-docker}"
elif [[ -n ${ANTIGRAVITY_HA_DEV_DOCKER_BIN:-} ]]; then
  echo "development Docker override requires ANTIGRAVITY_HA_DEV_TEST_MODE=1" >&2
  exit 64
fi

if [[ $command_name == install ]]; then
  "$docker_bin" pull "$IMAGE" >/dev/null
  "$docker_bin" volume create "$MEMORY_VOLUME" >/dev/null
  if ((test_mode == 0)); then
    node "$probe" >/dev/null
  fi
  echo "Host development tools installed. Start a new Codex session to load project MCP changes."
  exit 0
fi

"$docker_bin" image inspect "$IMAGE" >/dev/null
"$docker_bin" volume inspect "$MEMORY_VOLUME" >/dev/null
node "$probe"
echo "Host development setup is ready."
